DATABASE_URL=sqlite:///./finrisk.db
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_URL=http://localhost:8000

# Retrieval: "local" (ChromaDB, free) or "pageindex" (remote API, paid)
RETRIEVAL_MODE=local

# Local ChromaDB (when RETRIEVAL_MODE=local)
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PageIndex (when RETRIEVAL_MODE=pageindex)
PAGEINDEX_API_KEY=
PAGEINDEX_BASE_URL=https://api.pageindex.ai
PAGEINDEX_DOC_MAP=MSFT:pi-docid,AAPL:pi-docid
PAGEINDEX_POLL_INTERVAL_SECONDS=1
PAGEINDEX_POLL_TIMEOUT_SECONDS=45
PAGEINDEX_ENABLE_THINKING=false

# LLM (both modes)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
