# Stage 1: build the React app
FROM node:20-alpine AS builder
WORKDIR /app
COPY src/frontend/package*.json ./
RUN npm ci
COPY src/frontend/ .
# Empty VITE_API_URL so all /api calls use relative URLs — nginx proxies them
RUN VITE_API_URL="" npm run build

# Stage 2: serve built assets with nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# Add .mjs MIME type for PDF.js worker (not in nginx:alpine defaults)
RUN echo "    text/javascript  mjs;" >> /etc/nginx/mime.types
EXPOSE 80
